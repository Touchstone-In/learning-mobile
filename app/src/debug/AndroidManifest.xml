<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Debug-only manifest overlay:
        Allows cleartext HTTP traffic to the Elastic Beanstalk dev backend
        (learning-backend-2026 GitHub Actions deployment).
        This override does NOT affect staging or release builds.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig" />

</manifest>

