<network-security-config>
    <!-- All connections require HTTPS (learndev-be.tsin.ca is HTTPS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

